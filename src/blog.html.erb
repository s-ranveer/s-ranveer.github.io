<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= blog['title'] %> by <%= site['site']['name'] %>">
  <title><%= blog['title'] %> · <%= site['site']['name'] %></title>
  <link rel="stylesheet" href="../../style.css">
</head>
<body>
  <div class="page-shell blog-page">
    <header class="topbar">
      <a class="wordmark" href="../../"><span>RS</span> / <%= site['site']['name'] %></a>
      <a class="header-link" href="../../#publications">Back to papers <span aria-hidden="true">↗</span></a>
    </header>
    <main class="blog-article">
      <% publication = site['publications'].find { |paper| paper['bibtex'] == blog['paper'] } %>
      <p class="eyebrow">Research notes · <%= blog['date'] %></p>
      <h1><%= blog['title'] %></h1>
      <p class="blog-intro"><%= blog['intro'] %></p>
      <div class="blog-body"><% blog['body'].each do |paragraph| %><p><%= paragraph %></p><% end %></div>
      <a class="button button-dark" href="<%= publication['paper'] %>">Read the paper <span>↗</span></a>
    </main>
    <footer><div><a class="wordmark" href="../../"><span>RS</span> / <%= site['site']['name'] %></a><p>Researching better ways to reason about the world.</p></div><small>© <%= Time.now.year %> <%= site['site']['name'] %></small></footer>
  </div>
</body>
</html>